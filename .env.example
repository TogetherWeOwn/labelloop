# Local-only values; these are deliberately not production credentials.
POSTGRES_USER=labelloop
POSTGRES_PASSWORD=labelloop-local-only
POSTGRES_DB=labelloop
POSTGRES_PORT=5432
# Minio expects host:port, not a URL, and Compose overrides this to minio:9000.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=labelloop-local-only
S3_SECRET_KEY=labelloop-local-secret
S3_BUCKET=labelloop
API_PORT=8000
WEB_PORT=5173
S3_CONSOLE_PORT=9001
