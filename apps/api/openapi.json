{
  "components": {
    "schemas": {
      "AnnotationHistory": {
        "additionalProperties": false,
        "properties": {
          "next_before_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before Revision"
          },
          "revisions": {
            "items": {
              "$ref": "#/components/schemas/RevisionRecord"
            },
            "title": "Revisions",
            "type": "array"
          }
        },
        "required": [
          "revisions",
          "next_before_revision"
        ],
        "title": "AnnotationHistory",
        "type": "object"
      },
      "AnnotationSnapshot": {
        "additionalProperties": false,
        "properties": {
          "annotation": {
            "$ref": "#/components/schemas/RevisionRecord"
          },
          "asset_key": {
            "title": "Asset Key",
            "type": "string"
          },
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "project_key": {
            "title": "Project Key",
            "type": "string"
          },
          "source_sha256": {
            "title": "Source Sha256",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "project_key",
          "asset_key",
          "source_sha256",
          "width",
          "height",
          "annotation"
        ],
        "title": "AnnotationSnapshot",
        "type": "object"
      },
      "BoundaryError": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "BoundaryError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "name",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "RevisionRecord": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "actor_kind": {
            "title": "Actor Kind",
            "type": "string"
          },
          "approval_state": {
            "title": "Approval State",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "label_state": {
            "title": "Label State",
            "type": "string"
          },
          "objects": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Objects",
            "type": "array"
          },
          "parent_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Revision"
          },
          "recorded_gold_eligible": {
            "title": "Recorded Gold Eligible",
            "type": "boolean"
          },
          "recorded_training_eligible": {
            "title": "Recorded Training Eligible",
            "type": "boolean"
          },
          "review_tier": {
            "title": "Review Tier",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "scope_completeness": {
            "title": "Scope Completeness",
            "type": "string"
          }
        },
        "required": [
          "revision",
          "parent_revision",
          "actor_kind",
          "actor_id",
          "created_at",
          "objects",
          "label_state",
          "approval_state",
          "review_tier",
          "scope_completeness",
          "recorded_training_eligible",
          "recorded_gold_eligible"
        ],
        "title": "RevisionRecord",
        "type": "object"
      }
    }
  },
